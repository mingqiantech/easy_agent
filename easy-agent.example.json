{
  // ── 模型目录（OpenClaw 方案）：key = "<provider>/<model-id>"，alias 给短名 ──
  "models": {
    "qwencloud-token-plan/qwen3.8-flash": { "alias": "flash", "supportsVision": true },
    "qwencloud-token-plan/qwen3.8-max":   { "alias": "max",   "supportsVision": true },
    "openai/deepseek-v3": { "alias": "cheap" },
    "ollama/qwen3.5:9b":  { "alias": "local9b" }
  },

  // ── 主模型 + 有序故障转移链；ref / alias / 裸 id 三种写法均可 ──
  "model": { "primary": "flash", "fallbacks": ["cheap", "local9b"] },

  // ── 思考等级（OpenClaw 风格 thinking）：off | low | medium | high ──
  // 全局默认；各 agent 可用 thinking 独立覆盖；
  // 目录中标记 "reasoning": false 的模型会自动降级为 off（不发送思考参数）
  "thinkingDefault": "low",

  // ── 多 Agent（model/thinking/workspaceDir/description 各自独立；页面可切换） ──
  "agents": {
    "coder":  { "description": "编程助手", "model": "max", "thinking": "high" },
    "writer": { "description": "写作助手", "model": "flash", "thinking": "low" }
  },

  // ── providers ──
  // "api" = 底层协议（openai | anthropic | ollama | google | openrouter），
  //   允许自定义网关名（对齐 openclaw 的 provider 命名，如 "qwencloud-token-plan"）。
  // 值支持 "${ENV_VAR}" 占位符：运行时从环境变量（含 ~/.easy-agent/.env）注入，密钥不落盘。
  "providers": {
    "qwencloud-token-plan": {
      "api": "openai",
      "baseUrl": "https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1",
      "apiKey": "${OPENAI_API_KEY}"
    },
    "ollama": {
      "api": "ollama",
      "baseUrl": "http://localhost:11434",
      "apiKey": "ollama"
    }
  },

  "visionModel": "flash",
  "imageGenModel": "openai/dall-e-3",

  // ── 网页搜索后端（可选）──
  // provider: auto | tavily | brave | bocha | bing
  //   auto = 按 tavily > brave > bocha 顺序取第一个已填 key 的 API；都没填则用 Bing 抓取（免密钥）
  //   指定 provider 但该 key 缺失/API 失败时，也会自动回退 Bing 抓取
  // ── ACP 长会话 agent（acp_agent 工具，方案 B）──
  // agents 非空才注册；进程池复用：同 agent+workdir 的多轮对话上下文留在 Agent 侧
  // autoApprove=true：权限请求自动选 allow_once（工具场景无法交互审批，谨慎开）
  "acp": {
    "timeoutMinutes": 15,           // 单轮 prompt 上限
    "idleMinutes": 10,              // 空闲进程回收
    "autoApprove": true,
    "allowedWorkdirs": [],          // 缺省=各 agent 工作区
    "agents": {
      "trae": { "bin": "trae-cli", "args": ["acp", "serve"] }
    }
  },

  // ── 外部编码 agent：trae-cli（headless `-p --json`）──
  // 存在该节才注册 trae_agent 工具；yolo/permissionMode 仅配置层可开，模型传不了
  // ⚠️ 前置：trae-cli 需先完成登录与模型配置（WSL 无 keyring 时把 key 写进 ~/.traecli.yaml）
  "trae": {
    "enabled": true,
    "bin": "trae-cli",
    "timeoutMinutes": 10,
    "allowedWorkdirs": [],
    "allowedTools": ["Bash", "Read", "Edit"]
  },

  "websearch": {
    "provider": "auto",
    "tavilyApiKey": "${TAVILY_API_KEY}",
    "braveApiKey": "${BRAVE_API_KEY}",
    "bochaApiKey": "${BOCHA_API_KEY}"
  },
  "memorySearch": {
    "embedding": {
      "provider": "simple",
      "model": "nomic-embed-text",
      "baseUrl": "http://172.18.32.1:11434"
    },
    "hybrid": { "enabled": true, "vectorWeight": 0.7, "textWeight": 0.3 },
    "reindexIntervalMinutes": 10,
    "rerank": { "mmr": true, "lambda": 0.7, "halfLifeDays": 0 }
  }
}
