{
  // ── 模型目录（OpenClaw 方案）：key = "<provider>/<model-id>"，alias 给短名 ──
  "models": {
    "qwencloud-token-plan/qwen3.8-flash": { "alias": "flash", "supportsVision": true },
    "qwencloud-token-plan/qwen3.8-max":   { "alias": "max",   "supportsVision": true },
    "openai/deepseek-v3": { "alias": "cheap" },
    "ollama/qwen3.5:9b":  { "alias": "local9b" }
  },

  // ── 主模型 + 有序故障转移链；ref / alias / 裸 id 三种写法均可 ──
  "model": { "primary": "flash", "fallbacks": ["cheap", "local9b"] },

  // ── 思考等级（OpenClaw 风格 thinking）：off | low | medium | high ──
  // 全局默认；各 agent 可用 thinking 独立覆盖；
  // 目录中标记 "reasoning": false 的模型会自动降级为 off（不发送思考参数）
  "thinkingDefault": "low",

  // ── 多 Agent（model/thinking/workspaceDir/description 各自独立；页面可切换） ──
  "agents": {
    "coder":  { "description": "编程助手", "model": "max", "thinking": "high" },
    "writer": { "description": "写作助手", "model": "flash", "thinking": "low" }
  },

  // ── providers ──
  // "api" = 底层协议（openai | anthropic | ollama | google | openrouter），
  //   允许自定义网关名（对齐 openclaw 的 provider 命名，如 "qwencloud-token-plan"）。
  // 值支持 "${ENV_VAR}" 占位符：运行时从环境变量（含 ~/.easy-agent/.env）注入，密钥不落盘。
  "providers": {
    "qwencloud-token-plan": {
      "api": "openai",
      "baseUrl": "https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1",
      "apiKey": "${OPENAI_API_KEY}"
    },
    "ollama": {
      "api": "ollama",
      "baseUrl": "http://localhost:11434",
      "apiKey": "ollama"
    }
  },

  "visionModel": "flash",
  "imageGenModel": "openai/dall-e-3"
}
