{
  "name": "easy-agent",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "dev": "bun run packages/cli/src/entry.ts",
    "dev:server": "bun run packages/server/src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "build:binary": "bun build --compile packages/cli/src/entry.ts --outfile dist/easy-agent",
    "build:server": "bun build --compile packages/server/src/index.ts --outfile dist/easy-agent-gateway",
    "install:global": "bash scripts/install.sh",
    "install:global:with-server": "bash scripts/install.sh --server"
  },
  "devDependencies": {
    "typescript": "5.8.2",
    "@types/bun": "1.3.13"
  },
  "dependencies": {
    "@wecom/aibot-node-sdk": "^1.0.7",
    "sqlite-vec": "^0.1.9"
  }
}
