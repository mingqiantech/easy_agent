{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "types": ["bun-types"]
  },
  "references": [
    { "path": "packages/schema" },
    { "path": "packages/llm" },
    { "path": "packages/config" },
    { "path": "packages/core" },
    { "path": "packages/cli" }
  ]
}